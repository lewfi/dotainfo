---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dota 2 Pro Stats',
  description = 'Professional Dota 2 match results, drafts, and box scores.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#11151c" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      <header class="site-header">
        <nav aria-label="Primary navigation">
          <a class="site-name" href="/">Dota 2 Pro Stats</a>
        </nav>
      </header>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <p>Professional match data, built as a static site.</p>
      </footer>
    </div>
    <script is:inline>
      function updateRelativeTimes() {
        const formatter = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
        const units = [
          ['year', 31_536_000],
          ['month', 2_592_000],
          ['day', 86_400],
          ['hour', 3_600],
          ['minute', 60],
        ];
        for (const time of document.querySelectorAll('[data-relative-time]')) {
          const timestamp = Date.parse(time.dateTime);
          if (!Number.isFinite(timestamp)) continue;
          const difference = (timestamp - Date.now()) / 1000;
          const [unit, seconds] = units.find(([, size]) => Math.abs(difference) >= size)
            ?? ['second', 1];
          time.textContent = formatter.format(Math.trunc(difference / seconds), unit);
          time.title = new Date(timestamp).toISOString();
        }
      }

      updateRelativeTimes();
      window.setInterval(updateRelativeTimes, 60_000);
    </script>
  </body>
</html>
