---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dota 2 Pro Stats',
  description = 'Professional Dota 2 match results, drafts, and box scores.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-name" href="/">Dota 2 Pro Stats</a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>Professional match data, built as a static site.</p>
      </footer>
    </div>
  </body>
</html>
