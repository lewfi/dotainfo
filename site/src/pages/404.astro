---
import SiteLayout from '../layouts/SiteLayout.astro';
import { historicalSummaryReferenceRows } from '../data/historical-artifacts.mjs';

const references = await historicalSummaryReferenceRows();
const serializedReferences = JSON.stringify(references).replaceAll('<', '\\u003c');
---

<SiteLayout
  title="Match lookup — DotaInfo"
  description="Historical professional Dota 2 match summary lookup."
>
  <article
    class="historical-route"
    data-historical-route
    data-route-state="not-found"
    aria-live="polite"
    aria-busy="false"
  >
    <p class="eyebrow">Match archive</p>
    <h1 data-historical-title>Page not found</h1>
    <div data-historical-content>
      <p>The requested page does not exist.</p>
    </div>
  </article>
  <script
    id="historical-reference-data"
    type="application/json"
    set:html={serializedReferences}
  />
</SiteLayout>

<script>
  import {
    historicalRouteView,
    matchIdFromPathname,
    resolveHistoricalMatch,
  } from '../presentation/historical-route.mjs';
  import { ReferenceResolver } from '../presentation/reference-model.mjs';

  const route = document.querySelector('[data-historical-route]');
  const title = route?.querySelector('[data-historical-title]');
  const content = route?.querySelector('[data-historical-content]');
  const matchId = matchIdFromPathname(window.location.pathname);

  function setNotFound(message) {
    route.dataset.routeState = 'not-found';
    route.setAttribute('aria-busy', 'false');
    title.textContent = 'Match not found';
    content.replaceChildren(Object.assign(document.createElement('p'), { textContent: message }));
  }

  if (!matchId) {
    setNotFound('The requested page does not exist.');
  } else {
    route.dataset.routeState = 'loading';
    route.setAttribute('aria-busy', 'true');
    title.textContent = 'Loading match…';
    content.replaceChildren(Object.assign(document.createElement('p'), {
      textContent: 'Checking the committed match archive.',
    }));
    try {
      const manifestResponse = await fetch('/data/matches/manifest.json');
      if (!manifestResponse.ok) throw new Error('Unable to load the historical manifest.');
      const manifest = await manifestResponse.json();
      const resolved = await resolveHistoricalMatch(matchId, {
        manifest,
        async loadMonth(month) {
          const response = await fetch(`/data/matches/${month}.json`);
          if (!response.ok) throw new Error(`Unable to load historical month ${month}.`);
          return response.json();
        },
      });

      if (resolved.status === 'not-found') {
        const view = historicalRouteView(matchId, resolved, new ReferenceResolver());
        route.dataset.routeState = view.status;
        route.setAttribute('aria-busy', 'false');
        title.textContent = view.title;
        content.innerHTML = view.markup;
      } else {
        const referenceData = JSON.parse(
          document.querySelector('#historical-reference-data')?.textContent ?? '{}',
        );
        const view = historicalRouteView(
          matchId,
          resolved,
          new ReferenceResolver(referenceData),
        );
        route.dataset.routeState = view.status;
        route.setAttribute('aria-busy', 'false');
        title.textContent = view.title;
        content.innerHTML = view.markup;
      }
    } catch (error) {
      route.dataset.routeState = 'error';
      route.setAttribute('aria-busy', 'false');
      title.textContent = 'Match unavailable';
      content.replaceChildren(Object.assign(document.createElement('p'), {
        textContent: 'The historical match archive could not be loaded.',
      }));
    }
  }
</script>
