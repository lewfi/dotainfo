---
import HomeFeed from '../components/HomeFeed.astro';
import { BUILD_CLOCK, buildDataPaths } from '../build-context.mjs';
import { createCatalog } from '../data/catalog.mjs';
import { DataReader } from '../data/queries.mjs';
import { loadReferences } from '../data/references.mjs';
import SiteLayout from '../layouts/SiteLayout.astro';
import { createHomeFeedViews } from '../presentation/home-feed.mjs';

const { dataRoot, referenceRoot } = buildDataPaths();
const [catalog, references] = await Promise.all([
  createCatalog({ dataRoot }),
  loadReferences({ referenceRoot }),
]);
const reader = await DataReader.create(catalog);
let home;
try {
  home = await createHomeFeedViews({
    reader,
    references,
    clock: BUILD_CLOCK,
    limit: 100,
  });
} finally {
  reader.close();
}

function isoFromEpoch(epoch) {
  return new Date(epoch * 1000).toISOString();
}
---

<SiteLayout
  title="Recent Dota 2 matches"
  description="The newest 100 professional Dota 2 match results, filterable by league tier."
>
  <section class="home-intro" aria-labelledby="page-title">
    <p class="eyebrow">Dota 2 professional matches</p>
    <h1 id="page-title">Recent match results</h1>
    <p>The newest 100 matches for the selected league tiers.</p>
  </section>

  <section class="tier-control" aria-labelledby="tier-control-title">
    <h2 id="tier-control-title">League tiers</h2>
    <label for="home-view-select">Show</label>
    <select
      id="home-view-select"
      data-home-view-select
      data-current-view={home.views[0].id}
      aria-describedby="tier-filter-status tier-filter-range"
      aria-controls={home.views.map((view) => `home-view-${view.id}`).join(' ')}
    >
      {home.views.map((view, index) => (
        <option
          value={view.id}
          selected={index === 0}
          data-hidden-count={view.hiddenCount}
          data-range-start={isoFromEpoch(view.range.startEpoch)}
          data-range-end={isoFromEpoch(view.range.endEpoch)}
        >
          {view.label}
        </option>
      ))}
    </select>
    <p id="tier-filter-status" class="hidden-count" role="status" aria-live="polite">
      Current view: <strong data-current-view-output>{home.views[0].label}</strong>.
      <strong data-hidden-count-output>{home.views[0].hiddenCount}</strong> matches hidden.
      <span id="tier-filter-range" data-hidden-range>
        Counted from {isoFromEpoch(home.views[0].range.startEpoch)} inclusive to
        {' '}{isoFromEpoch(home.views[0].range.endEpoch)} exclusive.
      </span>
    </p>
  </section>

  {home.views.map((view, index) => <HomeFeed view={view} active={index === 0} />)}

  <script is:inline>
    const select = document.querySelector('[data-home-view-select]');
    const hiddenCount = document.querySelector('[data-hidden-count-output]');
    const hiddenRange = document.querySelector('[data-hidden-range]');
    const currentView = document.querySelector('[data-current-view-output]');

    function selectHomeView() {
      const option = select?.selectedOptions[0];
      if (!option) return;
      for (const view of document.querySelectorAll('[data-home-view]')) {
        view.hidden = view.dataset.homeView !== option.value;
      }
      select.dataset.currentView = option.value;
      currentView.textContent = option.textContent.trim();
      hiddenCount.textContent = option.dataset.hiddenCount;
      hiddenRange.textContent = `Counted from ${option.dataset.rangeStart} inclusive to ${option.dataset.rangeEnd} exclusive.`;
    }

    select?.addEventListener('change', selectHomeView);
  </script>
</SiteLayout>
