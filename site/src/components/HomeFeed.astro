---
import MatchSummary from './MatchSummary.astro';

const { view, active = false } = Astro.props;
---

<section
  class="home-view"
  id={`home-view-${view.id}`}
  data-home-view={view.id}
  aria-labelledby={`home-view-${view.id}-title`}
  hidden={!active}
>
  <h2 id={`home-view-${view.id}-title`}>{view.label}</h2>
  <p>{view.matches.length} newest matching matches</p>
  <ul class="tier-counts" aria-label="Tier counts in this view's time range">
    {view.tierCounts.map(({ tier, count }) => (
      <li data-tier={tier ?? ''}>{tier?.trim() || 'Tier unavailable'}: {count}</li>
    ))}
  </ul>
  <ol class="match-feed">
    {view.matches.map((match) => (
      <li class="match-card" data-match-id={match.matchId}>
        <article aria-labelledby={`match-${view.id}-${match.matchId}`}>
          <MatchSummary
            summary={match}
            headingId={`match-${view.id}-${match.matchId}`}
            headingLevel="h3"
          />
          <p class="match-link">
            <a href={`/matches/${match.matchId}/`}>View match {match.matchId} details</a>
          </p>
        </article>
      </li>
    ))}
  </ol>
</section>
