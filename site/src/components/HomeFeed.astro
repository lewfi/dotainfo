---
import HomeSeriesRow from './HomeSeriesRow.astro';

const { home } = Astro.props;
---

<section class="home-view" id="home-results" data-home-view="default" aria-labelledby="home-results-title">
  <header class="home-view-heading">
    <h2 id="home-results-title">Recent series results</h2>
    <p>{home.entries.length} newest series and standalone games</p>
  </header>
  {home.days.map((day, dayIndex) => (
    <section class="day-group" data-home-day-group aria-labelledby={`day-${dayIndex}`}>
      <header class="day-heading">
        <h3 id={`day-${dayIndex}`}>
          <span class="day-label-long">{day.label}</span>
          <span class="day-label-short" aria-hidden="true">{day.shortLabel}</span>
        </h3>
        <span aria-hidden="true"></span>
        <p>{day.count} {day.count === 1 ? 'result' : 'results'}</p>
      </header>
      {day.leagues.map((league, leagueIndex) => (
        <section class="league-group" data-home-league-group aria-labelledby={`league-${dayIndex}-${leagueIndex}`}>
          <header class="league-heading">
            <span class="tier-badge">{league.category.badge}</span>
            <h4 id={`league-${dayIndex}-${leagueIndex}`}>{league.name}</h4>
            <p>{league.entries.length} {league.entries.length === 1 ? 'result' : 'results'}</p>
          </header>
          <ol class="match-feed">
            {league.entries.map((entry) => (
              <HomeSeriesRow entry={entry} day={day.key} categoryId={league.category.id} />
            ))}
          </ol>
        </section>
      ))}
    </section>
  ))}
</section>
