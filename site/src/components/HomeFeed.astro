---
import HomeMatchRow from './HomeMatchRow.astro';

const { view, active = false } = Astro.props;
---

<section
  class="home-view"
  id={`home-view-${view.id}`}
  data-home-view={view.id}
  aria-labelledby={`home-view-${view.id}-title`}
  hidden={!active}
>
  <header class="home-view-heading">
    <h2 id={`home-view-${view.id}-title`}>{view.label}</h2>
    <p>{view.matches.length} newest matching matches</p>
  </header>

  {view.days.map((day, dayIndex) => (
    <section class="day-group" aria-labelledby={`day-${view.id}-${dayIndex}`}>
      <header class="day-heading">
        <h3 id={`day-${view.id}-${dayIndex}`}>
          <span class="day-label-long">{day.label}</span>
          <span class="day-label-short" aria-hidden="true">{day.shortLabel}</span>
        </h3>
        <span aria-hidden="true"></span>
        <p>{day.count} {day.count === 1 ? 'game' : 'games'}</p>
      </header>

      {day.leagues.map((league, leagueIndex) => (
        <section
          class="league-group"
          aria-labelledby={`league-${view.id}-${dayIndex}-${leagueIndex}`}
        >
          <header class="league-heading">
            <span class="tier-badge">{league.category.badge}</span>
            <h4 id={`league-${view.id}-${dayIndex}-${leagueIndex}`}>{league.name}</h4>
            <p>
              {league.matches.length} {league.matches.length === 1 ? 'game' : 'games'}
              {league.category.id === 'other' && (
                <> · tier {league.rawTier ? `“${league.rawTier}”` : 'unavailable'} mapped to Other</>
              )}
            </p>
          </header>
          <ol class="match-feed">
            {league.matches.map((match) => (
              <li class="match-card" data-match-id={match.matchId}>
                <HomeMatchRow match={match} />
              </li>
            ))}
          </ol>
        </section>
      ))}
    </section>
  ))}
</section>
