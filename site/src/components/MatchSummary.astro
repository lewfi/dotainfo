---
import { renderMatchSummaryMarkup } from '../presentation/match-summary-markup.mjs';

const {
  summary,
  headingId,
  headingLevel = 'h2',
  linkTeams = false,
  showPatch = false,
} = Astro.props;
const markup = renderMatchSummaryMarkup(summary, {
  headingId,
  headingLevel,
  linkTeams,
  showPatch,
});
---

<Fragment set:html={markup} />
