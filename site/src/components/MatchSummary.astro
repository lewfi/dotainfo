---
import { renderMatchSummaryMarkup } from '../presentation/match-summary-markup.mjs';

const {
  summary,
  headingId,
  headingLevel = 'h2',
  showPatch = false,
} = Astro.props;
const markup = renderMatchSummaryMarkup(summary, { headingId, headingLevel, showPatch });
---

<Fragment set:html={markup} />
